# Perfume Space — Apache Configuration & 301 Redirects from Old Tilda Site
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirects from old perfume-space.ru (Tilda) pages to new structure
  RewriteRule ^women/?$ /?gender=Женские#catalog [R=301,L,NE]
  RewriteRule ^men/?$ /?gender=Мужские#catalog [R=301,L,NE]
  RewriteRule ^unisex/?$ /?gender=Унисекс#catalog [R=301,L,NE]
  RewriteRule ^brands/?$ /#brands [R=301,L,NE]
  RewriteRule ^discount/?$ /#promo [R=301,L,NE]
  RewriteRule ^present/?$ /#promo [R=301,L,NE]
  RewriteRule ^reviews/?$ /#reviews [R=301,L,NE]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

ErrorDocument 404 /404.php

# Compression for fast loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
