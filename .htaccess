# Perfume Space — Apache: ЧПУ, 301-редиректы со старого сайта на Tilda
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Без www: www.perfume-space.ru → perfume-space.ru
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # 301 со старых адресов Tilda
  RewriteRule ^women/?$ https://%{HTTP_HOST}/category/women_parfum/ [R=301,L]
  RewriteRule ^men/?$ https://%{HTTP_HOST}/category/men_parfum/ [R=301,L]
  RewriteRule ^unisex/?$ https://%{HTTP_HOST}/category/unisex/ [R=301,L]
  RewriteRule ^discount/?$ https://%{HTTP_HOST}/#promo [R=301,L,NE]
  RewriteRule ^present/?$ https://%{HTTP_HOST}/#promo [R=301,L,NE]
  RewriteRule ^reviews/?$ https://%{HTTP_HOST}/#reviews [R=301,L,NE]
  RewriteRule ^catalog/?$ https://%{HTTP_HOST}/#catalog [R=301,L,NE]
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
  RewriteRule ^privacy\.php$ https://%{HTTP_HOST}/privacy/ [R=301,L]

  # Служебные папки закрыты
  RewriteRule ^(includes|data|reports|tools)/ - [F,L]

  # Динамическая карта сайта и данные каталога
  RewriteRule ^sitemap\.xml$ site.php [L]
  RewriteRule ^catalog\.js$ site.php [L]

  # Всё остальное, чего нет на диске, — в фронт-контроллер
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ site.php [L,QSA]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
